#!/bin/sh
# BariSign — self-updating bootstrapper.
#
# It reads the instructions from one file in the repository (install.sh), pinned
# to the newest commit so GitHub's cache cannot serve a stale mix. install.sh
# then fetches every file at that same commit, including this script and the
# pairing engine step, so `sh update` is the only command ever needed.
#
#   sh update          # update everything, in place
#
# The user never has to run curl or git by hand again.
cd "$(dirname "$0")" || exit 1

ATOM="https://github.com/barismd/barisign/commits/main.atom"
SHA=$(curl -sSL --max-time 25 "$ATOM" 2>/dev/null | python3 -c "
import re, sys
found = re.search(r'barismd/barisign/commit/([0-9a-f]{40})', sys.stdin.read())
print(found.group(1) if found else '')
" 2>/dev/null)
if [ -n "${SHA:-}" ]; then
    BASE="https://raw.githubusercontent.com/barismd/barisign/$SHA"
else
    BASE="https://raw.githubusercontent.com/barismd/barisign/main"
fi

tmp=".install.sh.update"
curl -fsSL --connect-timeout 15 --max-time 60 -H 'Cache-Control: no-cache' "$BASE/install.sh" -o "$tmp" || {
    echo "! no network; could not reach the repository"
    exit 1
}
if [ ! -s "$tmp" ]; then
    rm -f "$tmp"
    echo "! no network; could not fetch install.sh"
    exit 1
fi

BARISIGN_DIR="$(pwd)" sh "$tmp"
status=$?
if [ "$status" -eq 0 ]; then
    mv -f "$tmp" install.sh
else
    rm -f "$tmp"
fi
exit "$status"
