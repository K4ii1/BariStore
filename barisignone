#!/bin/sh
# BariSign one-device full install — same phone as signer and target.
#
#   sh barisignone   check -> Apple ID -> loopback pair -> download ->
#                    portal -> sign -> loopback install. No flags needed.
#
# Needs LocalDevVPN connected on this device; keep the volume audible while
# pairing (the app speaks so iOS holds it). EXPERIMENTAL and UNVERIFIED:
# report-back steps in docs/SINGLE_DEVICE.md sect. 5.
cd "$(dirname "$0")" || exit 1
exec python3 -u poc/barisign.py one "$@"
